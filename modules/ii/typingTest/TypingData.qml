    function wordsFor(profile) {
        switch (profile) {
        case "english_1k": return english1k;
        case "english_5k": return english5k;
        case "persian": return persian;
        case "code_javascript": return javascript;
        case "code_python": return python;
        case "code_rust": return rust;
        default: return english200;
        }
    }

    function quotesFor(profile) {
        return profile === "persian" ? persianQuotes : englishQuotes;
    }

    function directionFor(profile) {
        return profile === "persian" ? "rtl" : "ltr";
    }

    function parsePack(text) {
        try {
            const value = JSON.parse(text);
            if (Array.isArray(value) && value.every(item => typeof item === "string"))
                return {valid: value.length > 0, kind: "words", words: value.map(String)};
            if (Array.isArray(value?.words) && value.words.every(item => typeof item === "string"))
                return {valid: value.words.length > 0, kind: "words", name: value.name || "imported", words: value.words.map(String)};
            const quotes = Array.isArray(value?.quotes) ? value.quotes : (Array.isArray(value) ? value : []);
            if (quotes.length > 0 && quotes.every(item => typeof item?.text === "string"))
                return {valid: true, kind: "quotes", name: value.language || "imported", quotes};
            return {valid: false, message: "Expected a string array, {words:[...]}, or {quotes:[{text,...}]}"};
        } catch (error) {
            return {valid: false, message: `Invalid JSON: ${error}`};
        }
    }
