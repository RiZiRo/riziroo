#!/usr/bin/env bash

set -u

dbus-update-activation-environment --systemd \
    DISPLAY \
    WAYLAND_DISPLAY \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP \
    XDG_SESSION_TYPE

systemctl --user import-environment \
    DISPLAY \
    WAYLAND_DISPLAY \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP \
    XDG_SESSION_TYPE

systemctl --user daemon-reload

# The direct GDM entry does not hold Fedora's graphical session target active.
systemctl --user start hyprland-session.target

# Start both portal implementations before the frontend service.
systemctl --user start \
    xdg-desktop-portal-hyprland.service \
    xdg-desktop-portal-gtk.service
systemctl --user start xdg-desktop-portal.service

# v2rayN normally changes this back to manual while its local proxy is running.
if [[ "$(gsettings get org.gnome.system.proxy mode 2>/dev/null)" == "'manual'" ]] \
    && ! ss -ltnH 'sport = :10808' | grep -q .; then
    gsettings set org.gnome.system.proxy mode 'none'
fi
