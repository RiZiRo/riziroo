# Python bytecode from the helper scripts (scripts/lyrics, scripts/ai, ...)
__pycache__/
*.py[cod]

# Timestamped backups left behind by in-place edits
*.bak-*

# Knowledge-graph output, regenerated on demand
graphify-out/

# Superseded module snapshots kept for local reference only
.archive/

# Machine-specific display layout. hypr/monitors.lua.example is the template;
# the real file is per-machine and set-scale.sh rewrites it on every SUPER+CTRL+S.
hypr/monitors.lua

# Wallpaper frame cache -- personal media filenames, not config
hypr/custom/scripts/mpvpaper_thumbnails/
